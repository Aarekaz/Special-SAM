# Data directories (symlinked on HPC)
/data/
/wood_data/

# Model checkpoints
checkpoints/
*.pth
*.pt

# Pre-computed embeddings
*_embeddings*/
*.npy

# Results (regenerable): cannot use plain `results/` — it blocks `!` exceptions for
# subfolders. Ignore direct children only, then re-include what we track.
results/*
!results/crossdataset/
!results/crossdataset/**
!results/ablation/
!results/ablation/**
!results/tables/
!results/tables/**
!results/*.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.pdf

# Environment
.env
.venv/
env/
venv/

# Misc
*.zip
*.tar.gz

# Conductor workspace
.context/

# --- Exceptions: things we DO want to track ---

# Logs (small text files, valuable for reproducibility)
!logs/
!logs/**

# Paper figures and PDFs
!paper/figures/*.png
!paper/figures/*.jpg
!paper/**/figures/*.pdf
!paper/**/main.pdf
.gstack/

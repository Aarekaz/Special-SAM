# Data directories (symlinked on HPC)
/data/
/wood_data/

# Model checkpoints
checkpoints/
*.pth
*.pt

# Pre-computed embeddings
*_embeddings*/
*.npy

# Results (regenerable)
results/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# LaTeX build artifacts
paper/latex/*.aux
paper/latex/*.log
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.out
paper/latex/*.synctex.gz
paper/latex/*.fdb_latexmk
paper/latex/*.fls

# Environment
.env
.venv/
env/
venv/

# Misc
*.zip
*.tar.gz

# Conductor workspace
.context/

# --- Exceptions: things we DO want to track ---

# Logs (small text files, valuable for reproducibility)
!logs/
!logs/**

# Results CSVs and tables
!results/*.csv
!results/tables/
!results/ablation/

# Paper figures
!paper/figures/*.png
!paper/figures/*.jpg
